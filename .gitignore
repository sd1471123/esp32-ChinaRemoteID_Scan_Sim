# ESP-IDF 构建产物（build/ 与多目标目录 build_c5 等，后者单个就有 240MB+）
build*/
sdkconfig.old
dependencies.lock
managed_components/
main/page_gz.h

# 本地工具数据
**/.workbuddy/
.vscode/
.idea/
*.swp
.DS_Store

# Python
__pycache__/
*.pyc
# 临时构建日志 / 烧录日志
build_*.log
flash_*.log
*_role.log
# 抓取的串口启动日志
build_*.txt
boot_*.txt
# 本地标准原文与第三方参考实现（仅本地查阅，不入库）
docs/std/
# target 生成的本机配置，不入库（CI 由 sdkconfig.defaults* 生成）
sdkconfig
!sdkconfig.defaults*
# 本地编译出的 OTA 升级包（网页升级用，按芯片分开，不进仓库）
dist/
