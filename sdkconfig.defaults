# 跨芯片共用默认配置（esp32s3 / esp32c5 等）
# 自定义分区表：factory + ota_0 + ota_1 三个 app 槽，各 2MB
# （见 partition_table/partitionTable.csv）
# 内置默认 1MB app 分区对 RISC-V 目标（C3/C5/C6）偏小，固件约 1.03MB 会溢出
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_table/partitionTable.csv"

# 固件回滚：网页 OTA 写入的新固件带 PENDING_VERIFY 标记，只有在 app_main
# 完成全部初始化并调用 esp_ota_mark_app_valid_cancel_rollback() 后才算确认；
# 若新固件在这之前崩溃/复位，引导器自动退回上一版可用的固件。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- 蓝牙数据通道 + HTTPS（网页 Web Bluetooth 取数，腾出 Wi-Fi 上网看地图） ----
# 只开 BLE 外设 + 广播角色：手机当中心设备连上来读数据，省 flash 与 RAM
# （Bluedroid 双模用不上，NimBLE 体积只有它的一半左右）
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Wi-Fi AP 与 BLE 共用一根天线，必须开软件共存
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# 浏览器只在安全上下文（https / localhost）里暴露 navigator.bluetooth，
# 所以网页要能通过 https://192.168.4.1 打开。证书是自签的，见 main/certs/。
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# TLS 收发缓冲 16KB -> 4KB/2KB：C5 跑起 Wi-Fi AP + BLE 后空闲堆只有 70KB，
# 一条 TLS 会话的峰值约 19~30KB，实测 4 条并发就会 OOM 并把 Wi-Fi 一起拖垮。
#   IN=4096 收（客户端请求，不能太小，浏览器不协商 max_fragment_length 时会发 16KB 记录）
#   OUT=2048 发（响应用，mbedtls 会自动分片，页面 gzip 31KB 拆成 16 个记录照样能发）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# 动态收发缓冲：不用时把缓冲还给堆，会话空闲期间只留 mbedTLS 上下文。
# 这是给 C5 这种小内存 + 并发 TLS 场景最关键的一项，能把最低水位从 9KB 抬回 20KB 以上。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# ---- lwIP socket 池 ----
# 关键：esp_http_server 每个实例除了 max_open_sockets 个客户端槽，还要额外占 3 个
# socket（TCP 监听 + 收/发控制口），见 httpd_main.c 的 sanity check。
# 本项目同时跑 80（HTTP）和 443（HTTPS）两个实例，默认 10 个根本不够。
# 现在的分配（槽位见 crid_web.c：S3 HTTPS 6 / C5 HTTPS 4，HTTP 均为 2）：
#   2+3(HTTP) + 6+3(HTTPS) + 蓝牙桥接 1 + DHCP/DNS 2 + SNTP 1 = 18，池子取 24 留 6 条余量。
# 池子只有 20 时实测会打到 ENFILE：日志为 httpd_accept_conn: error in accept (23)，
# 紧接着 httpd_server: error accepting new connection——新连接直接被拒，第二台设备打不开。
CONFIG_LWIP_MAX_SOCKETS=24

# ---- lwIP TCP：让「手机断开热点」留下的死连接尽快释放 ----
# 现象：手机开着网页把 Wi-Fi 关掉再连回来，页面一直转圈、超时，等一两分钟才恢复。
# 原因是设备侧收不到对方消失的通知：旧连接还占着 httpd 的客户端槽（HTTP 6 / HTTPS 3），
# 新连接只能在 backlog 里排队；同时 lwIP 的 TCP PCB 也被 TIME_WAIT 占着（默认只有
# 16 条），重连瞬间挤满就再也接不上新连接。
#   MSL 60s -> 8s：TIME_WAIT / FIN_WAIT 从 2×60s 降到 2×8s，PCB 十几秒就回池
#   MAX_ACTIVE_TCP 16 -> 24：多留 8 条余量给浏览器的并发重连（每条 PCB 约 200 字节，
#   收发缓冲按需分配，对 C5 的空闲堆影响在 2KB 量级）
# 配套改动见 crid_web.c：客户端断开（只剩 0 个 station）时主动回收残留会话。
CONFIG_LWIP_TCP_MSL=8000
CONFIG_LWIP_MAX_ACTIVE_TCP=24

# ---- lwIP TCP 接收窗口：必须大于一个 TLS 记录（16KB），否则大块上传会死锁 ----
# 现象：网页「固件升级」进度条走到 60%~62%（约 800KB）就不动，页面一直显示
#       「正在上传，请勿关闭页面…」，既不报错也不前进，最后整机 Web 服务不可用
#       （ping 通、TCP 能连上，但握手立刻被关闭），必须重启设备才恢复。
# 实测（.tmp/stalltest.py，同一台 S3、同一镜像，只改发送块大小）：
#       4096 B 块 -> 1,399,792 B 全部发完，13 秒通过
#       8192 B 块 -> 停在 819,200 B，之后再无进展
#      65536 B 块 -> 停在 851,968 B，之后再无进展
#   停住时 Wi-Fi 一直在线（netsh 显示 connected），设备对新连接仍能正常响应 50 秒，
#   只有那条上传连接零推进——是接收方不再读取，不是链路断了。
# 机制：mbedTLS 必须收齐一个完整记录才能解密返回数据，而 TCP 窗口只有 5760 字节，
#   装不下 8KB/16KB 的记录 → 应用永远等不到完整记录，不再调用 recv → 窗口一直是 0
#   → 发送方永久阻塞。这就是经典的 TLS 接收窗口死锁。
# 取值：窗口 20KB（> 16KB 最大记录，留一个多 MSS 余量）；
#   RECVMBOX 6 -> 16，让 tcpip 线程能排队 16×1440≈23KB 的段，与窗口匹配；
#   SND_BUF 5760 -> 16384，下线（页面 gzip 100KB、CSV 导出）也能跑满。
CONFIG_LWIP_TCP_WND_DEFAULT=20480
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
